  },
  "blocks": [
    {
      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# File creation ownership in iiPaintEngine\n",
      "level": 1,
      "title": "File creation ownership in iiPaintEngine"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "Bitmap file encoders publish through native provider streams. Raster encoding and painting remain in the engine; the storage dependency imports no Qt or GUI adapter.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 4,
      "end_line": 4,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 5,
      "end_line": 8,
      "raw": "The common [ownership contract](../../iiFileProvider/docs/FILE_OWNERSHIP.md) defines stream, staging, control-file and\ninstalled-package rules. Source regression tests remain with this module; the\nworkspace creation audit also checks these boundaries. Build/deployment and target\nruntime validation are separate evidence.\n"
    },
    {
      "id": "b000006",
      "kind": "blank",
      "start_line": 9,
      "end_line": 9,
      "raw": "\n"
    },
    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 10,
      "end_line": 10,
      "raw": "Changed boundaries:\n"
    },
    {
