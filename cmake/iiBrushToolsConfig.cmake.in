@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT iiPaintEngine_DIR)
    set(iiPaintEngine_DIR "${CMAKE_CURRENT_LIST_DIR}/../iiPaintEngine")
endif()
find_dependency(iiPaintEngine 0.5 CONFIG COMPONENTS BrushTools)
if(NOT TARGET iiBrushTools::iiBrushTools)
    add_library(iiBrushTools::iiBrushTools INTERFACE IMPORTED)
    set_property(TARGET iiBrushTools::iiBrushTools PROPERTY INTERFACE_LINK_LIBRARIES iiPaintEngine::BrushTools)
endif()
