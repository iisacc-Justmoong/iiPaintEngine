@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

function(_iiPaintEngine_detect_target_platform out_var)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        set(${out_var} "ios" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(${out_var} "android" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
        set(${out_var} "wasm" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(${out_var} "macos" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(${out_var} "linux" PARENT_SCOPE)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        set(${out_var} "windows" PARENT_SCOPE)
    else()
        set(${out_var} "" PARENT_SCOPE)
    endif()
endfunction()

_iiPaintEngine_detect_target_platform(_iiPaintEngineTargetPlatform)

get_filename_component(_iiPaintEngineCurrentPrefixName "${PACKAGE_PREFIX_DIR}" NAME)
get_filename_component(_iiPaintEngineCurrentPrefixParent "${PACKAGE_PREFIX_DIR}" DIRECTORY)
get_filename_component(_iiPaintEngineCurrentPrefixParentName "${_iiPaintEngineCurrentPrefixParent}" NAME)
set(_iiPaintEngineInPlatformPrefix FALSE)
if(_iiPaintEngineCurrentPrefixParentName STREQUAL "platforms")
    set(_iiPaintEngineInPlatformPrefix TRUE)
endif()

if(NOT _iiPaintEngineTargetPlatform STREQUAL ""
        AND NOT (_iiPaintEngineInPlatformPrefix
            AND _iiPaintEngineCurrentPrefixName STREQUAL _iiPaintEngineTargetPlatform))
    if(_iiPaintEngineInPlatformPrefix)
        set(_iiPaintEnginePlatformConfig
            "${_iiPaintEngineCurrentPrefixParent}/${_iiPaintEngineTargetPlatform}/lib/cmake/iiPaintEngine/iiPaintEngineConfig.cmake")
    else()
        set(_iiPaintEnginePlatformConfig
            "${PACKAGE_PREFIX_DIR}/platforms/${_iiPaintEngineTargetPlatform}/lib/cmake/iiPaintEngine/iiPaintEngineConfig.cmake")
    endif()
    if(EXISTS "${_iiPaintEnginePlatformConfig}")
        include("${_iiPaintEnginePlatformConfig}")
        return()
    elseif(_iiPaintEngineTargetPlatform STREQUAL "ios"
            OR _iiPaintEngineTargetPlatform STREQUAL "android"
            OR _iiPaintEngineTargetPlatform STREQUAL "wasm")
        message(FATAL_ERROR
            "iiPaintEngine ${_iiPaintEngineTargetPlatform} package was not found at ${_iiPaintEnginePlatformConfig}. "
            "Run iiPaintEngine install.sh so it installs the platforms/${_iiPaintEngineTargetPlatform} package.")
    endif()
endif()

set(_iiPaintEngineDependencyPrefixes)
if(_iiPaintEngineTargetPlatform STREQUAL "macos")
    list(APPEND _iiPaintEngineDependencyPrefixes "/Volumes/Storage/Qt/6.8.3/macos")
elseif(_iiPaintEngineTargetPlatform STREQUAL "linux")
    list(APPEND _iiPaintEngineDependencyPrefixes "/Volumes/Storage/Qt/6.8.3/gcc_64")
elseif(_iiPaintEngineTargetPlatform STREQUAL "windows")
    list(APPEND _iiPaintEngineDependencyPrefixes
        "C:/Qt/6.8.3/mingw_64"
        "$ENV{USERPROFILE}/Qt/6.8.3/mingw_64"
        "/Volumes/Storage/Qt/6.8.3/mingw_64")
elseif(_iiPaintEngineTargetPlatform STREQUAL "ios")
    list(APPEND _iiPaintEngineDependencyPrefixes
        "/Volumes/Storage/Qt/6.8.3/ios"
        "/Volumes/Storage/Qt/6.8.3/macos")
elseif(_iiPaintEngineTargetPlatform STREQUAL "android")
    list(APPEND _iiPaintEngineDependencyPrefixes
        "/Volumes/Storage/Qt/6.8.3/android_arm64_v8a"
        "/Volumes/Storage/Qt/6.8.3/macos")
elseif(_iiPaintEngineTargetPlatform STREQUAL "wasm")
    list(APPEND _iiPaintEngineDependencyPrefixes
        "/Volumes/Storage/Qt/6.8.3/wasm_multithread"
        "/Volumes/Storage/Qt/6.8.3/wasm_singlethread"
        "/Volumes/Storage/Qt/6.8.3/macos")
endif()

list(REVERSE _iiPaintEngineDependencyPrefixes)
foreach(_iiPaintEngineDependencyPrefix IN LISTS _iiPaintEngineDependencyPrefixes)
    if(EXISTS "${_iiPaintEngineDependencyPrefix}")
        list(PREPEND CMAKE_PREFIX_PATH "${_iiPaintEngineDependencyPrefix}")
    endif()
endforeach()

unset(_iiPaintEngineDependencyPrefix)
unset(_iiPaintEngineDependencyPrefixes)
unset(_iiPaintEnginePlatformConfig)
unset(_iiPaintEngineInPlatformPrefix)
unset(_iiPaintEngineCurrentPrefixParentName)
unset(_iiPaintEngineCurrentPrefixParent)
unset(_iiPaintEngineCurrentPrefixName)
unset(_iiPaintEngineTargetPlatform)

find_dependency(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick)

if(APPLE)
    function(_iiPaintEngine_config_strip_agl_from_target target_name)
        if(NOT TARGET "${target_name}")
            return()
        endif()

        foreach(_iiPaintEngine_property IN ITEMS INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
            get_target_property(_iiPaintEngine_values "${target_name}" "${_iiPaintEngine_property}")
            if(NOT _iiPaintEngine_values)
                continue()
            endif()

            set(_iiPaintEngine_original_values "${_iiPaintEngine_values}")
            list(FILTER _iiPaintEngine_values EXCLUDE REGEX "(^|[ /])AGL($|[ /.])|AGL\\.framework")
            if(NOT _iiPaintEngine_values STREQUAL _iiPaintEngine_original_values)
                set_target_properties("${target_name}" PROPERTIES
                    "${_iiPaintEngine_property}" "${_iiPaintEngine_values}")
            endif()
        endforeach()
    endfunction()

    _iiPaintEngine_config_strip_agl_from_target(WrapOpenGL::WrapOpenGL)
    _iiPaintEngine_config_strip_agl_from_target(Qt6::Gui)
    _iiPaintEngine_config_strip_agl_from_target(Qt6::OpenGL)
    _iiPaintEngine_config_strip_agl_from_target(Qt6::Quick)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/iiPaintEngineTargets.cmake")

if(APPLE AND TARGET iiPaintEngine::iiPaintEngine)
    set_property(TARGET iiPaintEngine::iiPaintEngine APPEND PROPERTY
        INTERFACE_LINK_OPTIONS "-Wl,-rpath,${PACKAGE_PREFIX_DIR}/lib")
endif()
