@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/iiPaintEngineTargets.cmake")
set(iiPaintEngine_BrushTools_FOUND @IIPAINTENGINE_BUILD_BRUSH_TOOLS@)
if("BrushTools" IN_LIST iiPaintEngine_FIND_COMPONENTS AND iiPaintEngine_BrushTools_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/iiPaintEngineBrushToolsTargets.cmake")
endif()
if(APPLE AND TARGET iiPaintEngine::iiPaintEngine)
    set_property(TARGET iiPaintEngine::iiPaintEngine APPEND PROPERTY
        INTERFACE_LINK_OPTIONS "LINKER:-rpath,$<TARGET_FILE_DIR:iiPaintEngine::iiPaintEngine>")
endif()
check_required_components(iiPaintEngine)
